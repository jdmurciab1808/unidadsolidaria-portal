{#
/**
 * @file
 * Theme override to display a region.
 *
 * Available variables:
 * - content: The content for this region, typically blocks: either a rendered
 *   string or (with newer core) a render array of blocks keyed by block ID,
 *   so test emptiness on the rendered output rather than content itself.
 * - attributes: HTML attributes for the region div.
 * - region: The name of the region variable as defined in the theme's
 *   .info.yml file.
 *
 * @ingroup templates
 *
 * @see template_preprocess_region()
 */
#}
{%
  set classes = [
    'region',
    'region-' ~ region|clean_class,
  ]
%}
{#
  Render first: the blocks may all render empty.
  @see https://www.drupal.org/project/drupal/issues/3178202
#}
{% set rendered = content|render %}
{% if rendered|trim is not empty %}
  <div{{ attributes.addClass(classes) }}>
    {{ rendered }}
  </div>
{% endif %}
