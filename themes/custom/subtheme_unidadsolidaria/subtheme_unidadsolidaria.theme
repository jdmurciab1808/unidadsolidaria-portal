<?php

/**
 * @file
 * Bootstrap sub-theme.
 *
 * Place your custom PHP code in this file.
 */

use Drupal\Component\Utility\Html;

/**
 * Implements hook_preprocess_field().
 *
 * Listas de años: un párrafo o título del cuerpo que solo trae años
 * enlazados ("2013 - 2014 - 2015...") se convierte en una lista
 * (ul.us-anios) que el CSS muestra como tarjetas. Se hace después de los
 * filtros del formato de texto para que no le quiten la clase.
 */
function subtheme_unidadsolidaria_preprocess_field(array &$variables) {
  if ($variables['field_name'] !== 'body') {
    return;
  }
  // Párrafos de un solo enlace -> lista, en las páginas "vista elemento" que no
  // tienen diseño propio de us_entidad (Quiénes somos y sus secciones) y en los
  // demás tipos con el mismo diseño (noticias, foros, planes...).
  $nodo = $variables['element']['#object'] ?? NULL;
  $enlaces = $nodo && $nodo->getEntityTypeId() === 'node'
    && in_array($nodo->bundle(), array_merge(['vista_elemento'], array_diff(_subtheme_unidadsolidaria_tipos_con_titulo(), ['organismos'])), TRUE)
    && !in_array((int) $nodo->id(), _subtheme_unidadsolidaria_nids_us_entidad(), TRUE);
  // Introducción al comienzo del cuerpo -> recuadro como el de la descripción,
  // solo si la página no tiene el campo Descripción lleno.
  $intro = $enlaces && $nodo->hasField('field_descripcion') && trim(strip_tags((string) $nodo->get('field_descripcion')->value)) === '';
  // Con documentos o audios debajo, el cuerpo puede ser solo la introducción.
  $adjuntos = $intro && array_filter(['field_documentos', 'field_audios'], fn($campo) => $nodo->hasField($campo) && !$nodo->get($campo)->isEmpty());
  // Gremios (organismos), equipo directivo y las páginas de Transparencia
  // (título .title-transparencia): sin los párrafos y títulos vacíos que
  // dejaban huecos.
  // La página principal de Transparencia (nodo 23) se deja igual: su CSS cuenta
  // con esos párrafos.
  $limpiar = $nodo && $nodo->getEntityTypeId() === 'node'
    && (in_array($nodo->bundle(), ['organismos', 'equipo_directivo'], TRUE) || ($nodo->bundle() === 'page' && (int) $nodo->id() !== 23));
  foreach ($variables['items'] as &$item) {
    if (!isset($item['content']['#text'])) {
      continue;
    }
    $varios = substr_count($item['content']['#text'], '<a') >= 2;
    $vacios = $limpiar && ($nodo->bundle() !== 'page' || str_contains($item['content']['#text'], 'title-transparencia'));
    // Páginas de dependencias (cargo en Encabezado 6): las funciones se despliegan.
    $funciones = $enlaces && str_contains($item['content']['#text'], '<h6') && stripos($item['content']['#text'], 'Funciones') !== FALSE;
    if ($varios || $intro || $vacios || $funciones) {
      $item['content']['#post_render'][] = function ($html) use ($enlaces, $varios, $intro, $adjuntos, $vacios, $funciones) {
        if ($varios) {
          $html = _subtheme_unidadsolidaria_anios($html);
          $html = $enlaces ? _subtheme_unidadsolidaria_enlaces($html) : $html;
        }
        if ($vacios) {
          $html = _subtheme_unidadsolidaria_sin_vacios($html);
        }
        if ($funciones) {
          $html = _subtheme_unidadsolidaria_funciones($html);
        }
        return $intro ? _subtheme_unidadsolidaria_intro($html, (bool) $adjuntos) : $html;
      };
    }
  }
}

/**
 * Convierte el subtítulo "Funciones" y lo que le sigue en un desplegable.
 *
 * El subtítulo es un párrafo con solo negrita ("Funciones" o "Funciones:").
 * El desplegable (details.us-funciones) llega hasta el siguiente subtítulo en
 * negrita (p. ej. "Grupos y oficinas del Despacho") o hasta el final.
 */
function _subtheme_unidadsolidaria_funciones($html) {
  $html = (string) $html;
  $dom = Html::load($html);
  $cuerpo = (new \DOMXPath($dom))->query('//body')->item(0);
  $limpiar = fn($texto) => trim(preg_replace('/[\s\x{a0}]+/u', ' ', $texto));
  $subtitulo = function ($nodo) use ($limpiar) {
    if (!$nodo instanceof \DOMElement || $nodo->tagName !== 'p') {
      return NULL;
    }
    $negrita = $nodo->getElementsByTagName('strong')->item(0) ?? $nodo->getElementsByTagName('b')->item(0);
    $texto = $limpiar($nodo->textContent);
    return $negrita && $texto !== '' && $limpiar($negrita->textContent) === $texto ? rtrim($texto, ': ') : NULL;
  };
  $titulo = NULL;
  foreach ($cuerpo->childNodes as $nodo) {
    if (mb_strtolower((string) $subtitulo($nodo)) === 'funciones') {
      $titulo = $nodo;
      break;
    }
  }
  if (!$titulo) {
    return $html;
  }
  $mover = [];
  for ($nodo = $titulo->nextSibling; $nodo && $subtitulo($nodo) === NULL; $nodo = $nodo->nextSibling) {
    $mover[] = $nodo;
  }
  if (!array_filter($mover, fn($n) => $n instanceof \DOMElement)) {
    return $html;
  }
  $desplegable = $dom->createElement('details');
  $desplegable->setAttribute('class', 'us-funciones');
  $desplegable->appendChild($dom->createElement('summary', 'Funciones'));
  $contenido = $dom->createElement('div');
  $contenido->setAttribute('class', 'us-funciones__contenido');
  foreach ($mover as $nodo) {
    $contenido->appendChild($nodo);
  }
  $desplegable->appendChild($contenido);
  $titulo->parentNode->replaceChild($desplegable, $titulo);
  return Html::serialize($dom);
}

/**
 * Quita los párrafos y títulos del primer nivel que no traen texto ni imágenes.
 */
function _subtheme_unidadsolidaria_sin_vacios($html) {
  $html = (string) $html;
  $dom = Html::load($html);
  $cambio = FALSE;
  foreach (iterator_to_array((new \DOMXPath($dom))->query('//body/*[self::p or self::h2 or self::h3 or self::h4 or self::h5 or self::h6]')) as $bloque) {
    if (_subtheme_unidadsolidaria_vacio($bloque)) {
      $bloque->parentNode->removeChild($bloque);
      $cambio = TRUE;
    }
  }
  return $cambio ? Html::serialize($dom) : $html;
}

/**
 * Envuelve en div.us-intro los párrafos de texto con que empieza el cuerpo.
 *
 * Toma hasta tres párrafos seguidos de texto corrido (sin imágenes, que no sean
 * un solo enlace, un subtítulo en negrita ni un punto numerado). Un párrafo que termina en ":"
 * presenta lo que sigue, así que se queda fuera. Si después no viene nada más
 * (ni en el cuerpo ni documentos adjuntos), o la introducción es muy larga, no
 * se toca.
 */
function _subtheme_unidadsolidaria_intro($html, $adjuntos = FALSE) {
  $html = (string) $html;
  $dom = Html::load($html);
  $cuerpo = (new \DOMXPath($dom))->query('//body')->item(0);
  $limpiar = fn($texto) => trim(preg_replace('/[\s\x{a0}]+/u', ' ', $texto));
  $parrafos = [];
  $resto = FALSE;
  foreach (iterator_to_array($cuerpo->childNodes) as $nodo) {
    if ($nodo instanceof \DOMComment || ($nodo instanceof \DOMText && $limpiar($nodo->textContent) === '')) {
      continue;
    }
    if ($nodo instanceof \DOMElement && $nodo->tagName === 'p' && _subtheme_unidadsolidaria_vacio($nodo)) {
      continue;
    }
    $texto = $nodo instanceof \DOMElement ? $limpiar($nodo->textContent) : '';
    $prosa = $nodo instanceof \DOMElement && $nodo->tagName === 'p' && count($parrafos) < 3
      && mb_strlen($texto) >= 60 && !preg_match('/:$/u', $texto) && !preg_match('/^\d+\s*[.)\-]/u', $texto)
      && !$nodo->getElementsByTagName('img')->length && !$nodo->getElementsByTagName('iframe')->length
      && !_subtheme_unidadsolidaria_parrafo_enlace($nodo)
      && !($nodo->firstElementChild && in_array($nodo->firstElementChild->tagName, ['strong', 'b'], TRUE) && $limpiar($nodo->firstElementChild->textContent) === $texto);
    if ($prosa && !$resto) {
      $parrafos[] = $nodo;
      continue;
    }
    $resto = TRUE;
    break;
  }
  $largo = array_sum(array_map(fn($p) => mb_strlen($limpiar($p->textContent)), $parrafos));
  if (!$parrafos || !($resto || $adjuntos) || $largo > 1200) {
    return $html;
  }
  $caja = $dom->createElement('div');
  $caja->setAttribute('class', 'us-intro');
  $parrafos[0]->parentNode->insertBefore($caja, $parrafos[0]);
  foreach ($parrafos as $parrafo) {
    $caja->appendChild($parrafo);
  }
  return Html::serialize($dom);
}

/**
 * Implements hook_preprocess_node().
 *
 * Título de la página: los tipos de contenido que no traen un campo de título
 * propio (como field_titulo de vista elemento) no mostraban ninguno. Se agrega
 * el título del nodo como h1.us-titulo al comienzo del contenido.
 */
function subtheme_unidadsolidaria_preprocess_node(array &$variables) {
  $nodo = $variables['node'];
  if ($variables['view_mode'] !== 'full' || !in_array($nodo->bundle(), _subtheme_unidadsolidaria_tipos_con_titulo(), TRUE)) {
    return;
  }
  // Noticias y foros solo cuando su campo de título está vacío.
  foreach (['field_titulo_noticia', 'field_titulo_foro'] as $campo) {
    if ($nodo->hasField($campo) && !$nodo->get($campo)->isEmpty()) {
      return;
    }
  }
  $variables['content']['us_titulo'] = [
    '#type' => 'html_tag',
    '#tag' => 'h1',
    '#value' => Html::escape($nodo->label()),
    '#attributes' => ['class' => ['us-titulo']],
    '#weight' => -1000,
  ];
}

/**
 * Tipos de contenido a los que se les muestra el título del nodo.
 */
function _subtheme_unidadsolidaria_tipos_con_titulo() {
  return [
    'article',
    'noticia_principal',
    'foros',
    'equipo_directivo',
    'evento',
    'transparencia_y_acceso_a_la_info',
    'termino_glosario',
    'webform',
    'carrusel_publicidad',
    'slideshow',
    'organismos',
  ];
}

/**
 * Implements hook_preprocess_views_view().
 *
 * Equipo directivo: título de la página (antes salía con el primer directivo).
 */
function subtheme_unidadsolidaria_preprocess_views_view(array &$variables) {
  if ($variables['view']->id() === 'equipo_directivo') {
    $variables['header']['us_titulo'] = [
      '#type' => 'html_tag',
      '#tag' => 'h1',
      '#value' => t('Equipo Directivo'),
      '#attributes' => ['class' => ['us-titulo']],
      '#weight' => -100,
    ];
  }
}

/**
 * Implements hook_preprocess_views_view_unformatted().
 *
 * Equipo directivo en el orden de la entidad: Dirección Nacional, Subdirección,
 * Dirección Técnica de Desarrollo, Dirección Técnica de Investigación y
 * Planeación, Oficina Asesora Jurídica y Oficina de Control Interno. Un
 * directivo que no esté en la lista va al final.
 */
function subtheme_unidadsolidaria_preprocess_views_view_unformatted(array &$variables) {
  if ($variables['view']->id() !== 'equipo_directivo') {
    return;
  }
  $orden = array_flip([85, 83, 81, 82, 80, 84]);
  $posicion = [];
  foreach ($variables['view']->result as $indice => $fila) {
    $nid = isset($fila->_entity) ? (int) $fila->_entity->id() : 0;
    $posicion[$indice] = $orden[$nid] ?? 100 + $indice;
  }
  uksort($variables['rows'], fn($a, $b) => ($posicion[$a] ?? 999) <=> ($posicion[$b] ?? 999));
}

/**
 * Nodos con plantilla propia del módulo us_entidad.
 */
function _subtheme_unidadsolidaria_nids_us_entidad() {
  $nids = defined('US_ENTIDAD_NID_QUIENES') ? [US_ENTIDAD_NID_QUIENES] : [];
  return array_merge($nids, defined('US_ENTIDAD_NIDS_SECCION') ? US_ENTIDAD_NIDS_SECCION : []);
}

/**
 * Agrupa en ul.us-enlaces los párrafos seguidos que solo traen un enlace.
 *
 * Así quedan las listas de enlaces escritas como párrafos sueltos (muchas
 * pegadas desde Word) o como títulos seguidos de un solo enlace cada uno
 * ("Vigencia 2025", "Vigencia 2024"...). Un párrafo con sangría (espacios antes del enlace) queda
 * como subnivel. Hacen falta al menos dos párrafos seguidos; los párrafos
 * vacíos entre ellos se quitan.
 */
function _subtheme_unidadsolidaria_enlaces($html) {
  $html = (string) $html;
  $dom = Html::load($html);
  $xpath = new \DOMXPath($dom);
  $cuerpo = $xpath->query('//body')->item(0);
  $grupos = [];
  $grupo = [];
  $vacios = [];
  foreach (iterator_to_array($cuerpo->childNodes) as $nodo) {
    if ($nodo instanceof \DOMText && trim($nodo->textContent, " \t\n\r\0\x0B\u{a0}") === '') {
      continue;
    }
    $enlace = $nodo instanceof \DOMElement && in_array($nodo->tagName, ['p', 'h2', 'h3', 'h4', 'h5', 'h6'], TRUE) ? _subtheme_unidadsolidaria_parrafo_enlace($nodo) : NULL;
    if ($enlace) {
      $grupo[] = [$nodo] + $enlace;
      continue;
    }
    if ($grupo && $nodo instanceof \DOMElement && $nodo->tagName === 'p' && _subtheme_unidadsolidaria_vacio($nodo)) {
      $vacios[] = $nodo;
      continue;
    }
    $grupos[] = [$grupo, $vacios];
    $grupo = [];
    $vacios = [];
  }
  $grupos[] = [$grupo, $vacios];
  $cambio = FALSE;
  foreach ($grupos as [$grupo, $vacios]) {
    if (count($grupo) < 2) {
      continue;
    }
    $lista = $dom->createElement('ul');
    $lista->setAttribute('class', 'us-enlaces');
    foreach ($grupo as [$parrafo, $enlace, $sangria]) {
      $nuevo = $dom->createElement('a');
      $nuevo->appendChild($dom->createTextNode(trim(preg_replace('/[\s\x{a0}]+/u', ' ', $enlace->textContent))));
      foreach (['href', 'target', 'rel', 'title'] as $atributo) {
        if ($enlace->hasAttribute($atributo)) {
          $nuevo->setAttribute($atributo, $enlace->getAttribute($atributo));
        }
      }
      $li = $dom->createElement('li');
      if ($sangria) {
        $li->setAttribute('class', 'us-enlaces__sub');
      }
      $li->appendChild($nuevo);
      $lista->appendChild($li);
    }
    $grupo[0][0]->parentNode->insertBefore($lista, $grupo[0][0]);
    foreach ($grupo as [$parrafo]) {
      $parrafo->parentNode->removeChild($parrafo);
    }
    foreach ($vacios as $vacio) {
      if ($vacio->parentNode) {
        $vacio->parentNode->removeChild($vacio);
      }
    }
    $cambio = TRUE;
  }
  return $cambio ? Html::serialize($dom) : $html;
}

/**
 * Devuelve [enlace, sangría] si el párrafo solo trae un enlace de texto.
 */
function _subtheme_unidadsolidaria_parrafo_enlace(\DOMElement $parrafo) {
  $enlaces = $parrafo->getElementsByTagName('a');
  if ($enlaces->length !== 1 || $parrafo->getElementsByTagName('img')->length) {
    return NULL;
  }
  $enlace = $enlaces->item(0);
  $limpiar = fn($texto) => preg_replace('/[\s\x{a0}]+/u', '', $texto);
  if ($limpiar($enlace->textContent) === '' || !$enlace->getAttribute('href')
    || $limpiar($parrafo->textContent) !== $limpiar($enlace->textContent)) {
    return NULL;
  }
  // Sangría: dos o más espacios antes del enlace.
  $antes = '';
  for ($nodo = $parrafo->firstChild; $nodo && !$nodo->isSameNode($enlace) && !($nodo instanceof \DOMElement && $nodo->getElementsByTagName('a')->length); $nodo = $nodo->nextSibling) {
    $antes .= $nodo->textContent;
  }
  return [1 => $enlace, 2 => mb_strlen(preg_replace('/[^\s\x{a0}]/u', '', $antes)) >= 2];
}

/**
 * Párrafo sin texto ni imágenes (p. ej. <p>&nbsp;</p>).
 */
function _subtheme_unidadsolidaria_vacio(\DOMElement $parrafo) {
  return preg_replace('/[\s\x{a0}]+/u', '', $parrafo->textContent) === ''
    && !$parrafo->getElementsByTagName('img')->length
    && !$parrafo->getElementsByTagName('iframe')->length;
}

/**
 * Convierte en ul.us-anios los bloques del HTML formados solo por años enlazados.
 */
function _subtheme_unidadsolidaria_anios($html) {
  $html = (string) $html;
  if (substr_count($html, '<a') < 3) {
    return $html;
  }
  $dom = Html::load($html);
  $xpath = new \DOMXPath($dom);
  $cambio = FALSE;
  foreach ($xpath->query('//body/*[self::p or self::h2 or self::h3 or self::h4 or self::h5 or self::h6]') as $bloque) {
    $enlaces = [];
    foreach ($bloque->childNodes as $nodo) {
      if ($nodo instanceof \DOMText) {
        // Entre enlace y enlace solo puede haber separadores.
        if (preg_replace('/[\s\x{a0}\-–|·,]+/u', '', $nodo->textContent) !== '') {
          continue 2;
        }
      }
      elseif ($nodo instanceof \DOMElement && $nodo->tagName === 'a' && !$nodo->getElementsByTagName('img')->length) {
        $anio = trim($nodo->textContent, " \t\n\r\0\x0B\u{a0}-–");
        if (!preg_match('/^\d{4}$/', $anio)) {
          continue 2;
        }
        $enlaces[] = [$nodo, $anio];
      }
      elseif (!($nodo instanceof \DOMComment)) {
        continue 2;
      }
    }
    if (count($enlaces) < 3) {
      continue;
    }
    $lista = $dom->createElement('ul');
    $lista->setAttribute('class', 'us-anios');
    foreach ($enlaces as [$enlace, $anio]) {
      $nuevo = $dom->createElement('a', $anio);
      foreach (['href', 'target', 'rel', 'title'] as $atributo) {
        if ($enlace->hasAttribute($atributo)) {
          $nuevo->setAttribute($atributo, $enlace->getAttribute($atributo));
        }
      }
      $li = $dom->createElement('li');
      $li->appendChild($nuevo);
      $lista->appendChild($li);
    }
    $bloque->parentNode->replaceChild($lista, $bloque);
    $cambio = TRUE;
  }
  return $cambio ? Html::serialize($dom) : $html;
}
